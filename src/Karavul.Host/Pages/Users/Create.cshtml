@page
@using Karavul.Core.Enums
@model Karavul.Host.Pages.Users.CreateModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="page-header">
    <div class="header-content">
        <h1 class="page-title">Yeni Kullanıcı Oluştur</h1>
    </div>
</div>

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <form method="post">
        <div class="form-group">
            <label class="form-label">Kullanıcı Adı</label>
            <input type="text" asp-for="Username" class="form-control" required autocomplete="off" />
        </div>

        <div class="form-group">
            <label class="form-label">Şifre (Geçici)</label>
            <input type="password" asp-for="Password" class="form-control" required autocomplete="new-password" />
            <small class="form-text text-muted">Kullanıcı ilk girişinde şifresini değiştirmek zorundadır.</small>
        </div>

        <div class="form-group">
            <label class="form-label">Roller</label>
            <div class="checkbox-list">
                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <label class="checkbox-label" style="display: block; margin-bottom: 8px;">
                        <input type="checkbox" name="SelectedRoles" value="@role" @(role == UserRole.Viewer ? "checked" : "") />
                        <strong>@role</strong>
                        @if (role == UserRole.Admin) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">(Sistemdeki her şeye tam erişim)</span> }
                        @if (role == UserRole.Editor) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">(İzleme noktası ve iletişim grubu yönetimi)</span> }
                        @if (role == UserRole.Operator) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">(Alarmlara müdahale etme yetkisi)</span> }
                        @if (role == UserRole.Viewer) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">(Sadece görüntüleme)</span> }
                    </label>
                }
            </div>
        </div>

        <div class="form-actions" style="margin-top: 24px; display: flex; gap: 12px;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Users/Index" class="btn btn-outline">İptal</a>
        </div>
    </form>
</div>
