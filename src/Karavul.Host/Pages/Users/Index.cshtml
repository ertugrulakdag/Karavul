@page
@model Karavul.Host.Pages.Users.IndexModel
@inject Karavul.Host.Localization.ILocalizationService Loc
@{
    ViewData["Title"] = Loc["kullanicilar"];
}

<div class="page-header">
    <div class="header-content">
        <h1 class="page-title">@Loc["kullanici-yonetimi"]</h1>
        <p class="page-description">@Loc["kullanici-yonetimi-aciklama"]</p>
    </div>
    <div class="header-actions">
        <a href="/Users/Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            @Loc["yeni-kullanici"]
        </a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>@Loc["kullanici-adi"]</th>
                    <th>@Loc["roller"]</th>
                    <th>@Loc["son-giris"]</th>
                    <th>@Loc["islemler"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.UsersList)
                {
                    <tr>
                        <td><strong>@user.Username</strong></td>
                        <td>
                            @if (user.Role.HasFlag(Karavul.Core.Enums.UserRole.Admin))
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            @if (user.Role.HasFlag(Karavul.Core.Enums.UserRole.Editor))
                            {
                                <span class="badge bg-warning text-dark">Editor</span>
                            }
                            @if (user.Role.HasFlag(Karavul.Core.Enums.UserRole.Operator))
                            {
                                <span class="badge bg-info text-dark">Operator</span>
                            }
                            @if (user.Role.HasFlag(Karavul.Core.Enums.UserRole.Viewer))
                            {
                                <span class="badge bg-secondary">Viewer</span>
                            }
                        </td>
                        <td>
                            @(user.LastLoginAt?.ToString("g") ?? Loc["hic-giris-yapmadi"])
                        </td>
                        <td>
                            <div class="actions">
                                <a href="/Users/Edit?id=@user.Id" class="btn btn-secondary btn-sm btn-icon" title="@Loc["duzenle"]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                @if (user.Id != HttpContext.Session.GetString("UserId"))
                                {
                                    <form method="post" asp-page-handler="Delete" style="display:inline;">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm btn-icon" title="@Loc["sil"]" data-confirm="@Loc["kullaniciyi-sil-onay"]">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
