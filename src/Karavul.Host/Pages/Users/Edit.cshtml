@page
@using Karavul.Core.Enums
@model Karavul.Host.Pages.Users.EditModel
@inject Karavul.Host.Localization.ILocalizationService Loc
@{
    ViewData["Title"] = Loc["rol-duzenle"];
}

<div class="page-header">
    <div class="header-content">
        <h1 class="page-title">@Loc["rol-duzenle"]: @Model.Username</h1>
    </div>
</div>

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <form method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label class="form-label">@Loc["kullanici-adi"]</label>
            <input type="text" value="@Model.Username" class="form-control" disabled />
        </div>

        <div class="form-group">
            <label class="form-label">@Loc["roller"]</label>
            <div class="checkbox-list">
                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <label class="checkbox-label" style="display: block; margin-bottom: 8px;">
                        <input type="checkbox" name="SelectedRoles" value="@role" @(Model.SelectedRoles.Contains(role) ? "checked" : "") />
                        <strong>@role</strong>
                        @if (role == UserRole.Admin) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">@Loc["rol-admin-aciklama"]</span> }
                        @if (role == UserRole.Editor) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">@Loc["rol-editor-aciklama"]</span> }
                        @if (role == UserRole.Operator) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">@Loc["rol-operator-aciklama"]</span> }
                        @if (role == UserRole.Viewer) { <span class="text-muted" style="font-size: 12px; margin-left: 8px;">@Loc["rol-viewer-aciklama"]</span> }
                    </label>
                }
            </div>
        </div>

        <div class="form-actions" style="margin-top: 24px; display: flex; justify-content:space-between; align-items: center;">
            <div style="display: flex; gap: 12px;">
                <button type="submit" class="btn btn-primary">@Loc["kaydet"]</button>
                <a href="/Users/Index" class="btn btn-outline">@Loc["iptal"]</a>
            </div>
            @if(Model.UpdatedAt != default)
            {
                <div style="font-size:0.75rem; color:var(--text-muted);">
                    @Loc["son-guncelleme"]: @(Model.UpdatedBy ?? Loc["bilinmiyor"]) (@Model.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                </div>
            }
        </div>
    </form>
</div>
