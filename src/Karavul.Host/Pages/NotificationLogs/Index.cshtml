@page
@model Karavul.Host.Pages.NotificationLogs.IndexModel
@inject Karavul.Host.Localization.ILocalizationService Loc
@{
    ViewData["Title"] = Loc["bildirim-gecmisi"];
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Loc["bildirim-gecmisi"]</h1>
        <p class="page-subtitle">@Loc["tum-bildirim-gecmisi"]</p>
    </div>
</div>

<div class="card">
    @if (!Model.Logs.Any())
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            <p>@Loc["henuz-bildirim-gonderilmedi"]</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>@Loc["tarih"]</th>
                        <th>@Loc["durum"]</th>
                        <th>@Loc["tip"]</th>
                        <th>@Loc["monitor"]</th>
                        <th>@Loc["alici"]</th>
                        <th>@Loc["konu"]</th>
                        <th>@Loc["hata"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        var monitorName = Model.MonitorNames.TryGetValue(log.MonitorId, out var mn) ? mn : log.MonitorId;
                        <tr>
                            <td style="font-size:0.78rem; color:var(--text-muted);">@log.SentAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                @if (log.IsSuccess)
                                {
                                    <span class="badge badge-up">✓ @Loc["basarili"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-down">✗ @Loc["basarisiz"]</span>
                                }
                            </td>
                            <td><span class="badge badge-info">@log.NotificationType</span></td>
                            <td style="font-weight:600; font-size:0.82rem;">@monitorName</td>
                            <td style="font-size:0.8rem; color:var(--text-secondary);">@log.Recipient</td>
                            <td style="font-size:0.78rem; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;" onclick="showLogDetail('@log.Id')" title="@Loc["icerigi-gormek-icin-tiklayin"]">
                                <span>@log.Subject</span>
                                <div id="subject-@log.Id" style="display:none;">@log.Subject</div>
                                <div id="message-@log.Id" style="display:none;">@log.Message</div>
                            </td>
                            <td style="font-size:0.75rem; color:var(--red);">@log.ErrorMessage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model.Pagination" />
    }
</div>

<dialog id="logModal" style="border:none; border-radius:12px; padding:0; box-shadow:0 20px 40px rgba(0,0,0,0.3); max-width:600px; width:100%; margin:auto; background:var(--bg-surface); color:var(--text-primary); overflow:hidden;">
    <div style="background:var(--bg-panel); padding:20px 24px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border);">
        <h2 class="card-title" style="margin:0; font-size:1.2rem; display:flex; align-items:center; gap:8px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:var(--accent);"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            @Loc["bildirim-detayi"]
        </h2>
        <button onclick="document.getElementById('logModal').close()" style="background:none;border:none;cursor:pointer;font-size:1.5rem;line-height:1;color:var(--text-muted); transition:color 0.2s;" onmouseover="this.style.color='var(--text-main)'" onmouseout="this.style.color='var(--text-muted)'">&times;</button>
    </div>
    <div style="padding:24px;">
        <div style="font-weight:600; margin-bottom:16px; font-size:1rem; display:flex; align-items:flex-start; gap:8px;" id="logModalSubject"></div>
        <div style="font-size:0.85rem; max-height:400px; overflow-y:auto; background:var(--bg-body); border-radius:8px; border:1px solid var(--border);">
            <pre id="logModalMessage" style="white-space:pre-wrap; padding:16px; font-family:'JetBrains Mono', 'Courier New', Courier, monospace; margin:0; line-height:1.5; color:var(--text-secondary);"></pre>
        </div>
    </div>
</dialog>

<script>
    function showLogDetail(id) {
        var subject = document.getElementById('subject-' + id).innerText;
        var message = document.getElementById('message-' + id).innerText;
        
        document.getElementById('logModalSubject').innerText = subject;
        document.getElementById('logModalMessage').innerText = message;
        
        document.getElementById('logModal').showModal();
    }
</script>
