@page
@model Karavul.Host.Pages.Monitors.CreateModel
@{
    ViewData["Title"] = "Yeni Monitör";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Yeni Monitör Ekle</h1>
        <p class="page-subtitle">HTTP/HTTPS endpoint izlemesi için monitör oluşturun</p>
    </div>
    <a href="/Monitors" class="btn btn-secondary">← Geri</a>
</div>

<div class="card" style="max-width:720px;">
    <form method="post">
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">Monitör Adı * <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-monitor-adi"]</span></span></label>
                <input asp-for="Monitor.Name" class="form-control" placeholder="Örn: Ana Sayfa" required />
            </div>
            <div class="form-group">
                <label class="form-label">URL * <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-url"]</span></span></label>
                <input asp-for="Monitor.Url" class="form-control" type="url" placeholder="https://example.com" required />
            </div>
        </div>

        <div class="form-grid-3">
            <div class="form-group">
                <label class="form-label">HTTP Metodu <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-http-metodu"]</span></span></label>
                <select asp-for="Monitor.HttpMethod" class="form-control">
                    <option value="GET">GET</option>
                    <option value="HEAD">HEAD</option>
                    <option value="POST">POST</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Beklenen HTTP Kodu <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-beklenen-http-kodu"]</span></span></label>
                <input asp-for="Monitor.ExpectedStatusCode" class="form-control" type="number" min="100" max="599" />
            </div>
            <div class="form-group">
                <label class="form-label">İletişim Grubu <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-iletisim-grubu"]</span></span></label>
                <select asp-for="Monitor.ContactGroupId" asp-items="Model.ContactGroups" class="form-control"></select>
            </div>
        </div>

        <div class="form-grid-3">
            <div class="form-group">
                <label class="form-label">Kontrol Aralığı (sn) <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-kontrol-araligi"]</span></span></label>
                <input asp-for="Monitor.CheckIntervalSeconds" class="form-control" type="number" min="10" max="86400" />
            </div>
            <div class="form-group">
                <label class="form-label">Timeout (sn) <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-timeout"]</span></span></label>
                <input asp-for="Monitor.TimeoutSeconds" class="form-control" type="number" min="1" max="120" />
            </div>
            <div class="form-group">
                <label class="form-label">Maks. Yanıt Süresi (ms) <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-maks-yanit-suresi"]</span></span></label>
                <input asp-for="Monitor.MaxResponseTimeMs" class="form-control" type="number" min="0" />
            </div>
        </div>

        <div class="form-grid-3">
            <div class="form-group">
                <label class="form-label">Tetikleme Süresi (sn) <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-tetikleme-suresi"]</span></span></label>
                <input asp-for="Monitor.TriggerRate" class="form-control" type="number" min="10" max="600" />
            </div>
            <div class="form-group">
                <label class="form-label">SSL Uyarı Eşiği (gün) <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-ssl-uyari-esigi"]</span></span></label>
                <input asp-for="Monitor.SslWarningDays" class="form-control" type="number" min="1" max="365" />
            </div>
            <div class="form-group">
                <label class="form-label">Açıklama <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-aciklama"]</span></span></label>
                <input asp-for="Monitor.Description" class="form-control" placeholder="İsteğe bağlı not" />
            </div>
        </div>

        <div style="display:flex; gap:24px; margin-bottom:8px;">
            <div class="form-check" style="gap:10px;">
                <label class="toggle-switch">
                    <input asp-for="Monitor.IsActive" type="checkbox" id="isActive" />
                    <span class="toggle-slider"></span>
                </label>
                <label class="form-label" for="isActive" style="margin:0;cursor:pointer;">Aktif <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-aktif"]</span></span></label>
            </div>
            <div class="form-check" style="gap:10px;">
                <label class="toggle-switch">
                    <input asp-for="Monitor.CheckSsl" type="checkbox" id="checkSsl" />
                    <span class="toggle-slider"></span>
                </label>
                <label class="form-label" for="checkSsl" style="margin:0;cursor:pointer;">SSL Kontrolü Yap <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-ssl-kontrolu-yap"]</span></span></label>
            </div>
            <div class="form-check" style="gap:10px;">
                <label class="toggle-switch">
                    <input asp-for="Monitor.IsHealthJson" type="checkbox" id="isHealthJson" />
                    <span class="toggle-slider"></span>
                </label>
                <label class="form-label" for="isHealthJson" style="margin:0;cursor:pointer;">Sağlık Detaylarını (JSON) Oku <span class="info-tooltip-container"><button type="button" class="info-tooltip-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></button><span class="info-tooltip-content">@Loc["tt-saglik-detaylarini-oku"]</span></span></label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                Monitör Ekle
            </button>
            <a href="/Monitors" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var urlInput = document.getElementById("Monitor_Url");
        var isHealthJsonCb = document.getElementById("isHealthJson");

        if (urlInput && isHealthJsonCb) {
            urlInput.addEventListener("input", function () {
                if (urlInput.value.toLowerCase().endsWith("/health")) {
                    isHealthJsonCb.checked = true;
                }
            });
        }
    });
</script>
