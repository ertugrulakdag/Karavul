@inject Karavul.Host.Localization.ILocalizationService Loc
@{
    var currentPath = Context.Request.Path.Value ?? "";
    var username = Context.Session.GetString("Username") ?? "Admin";
    var userRoleValue = Context.Session.GetInt32("UserRole") ?? (int)Karavul.Core.Enums.UserRole.Admin;
    var userRolesList = new List<string>();
    if ((userRoleValue & (int)Karavul.Core.Enums.UserRole.Admin) != 0) userRolesList.Add(Loc["rol-admin"]);
    if ((userRoleValue & (int)Karavul.Core.Enums.UserRole.Editor) != 0) userRolesList.Add(Loc["rol-editor"]);
    if ((userRoleValue & (int)Karavul.Core.Enums.UserRole.Operator) != 0) userRolesList.Add(Loc["rol-operator"]);
    if ((userRoleValue & (int)Karavul.Core.Enums.UserRole.Viewer) != 0) userRolesList.Add(Loc["rol-viewer"]);
    var userRoleStr = string.Join(", ", userRolesList);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Karavul - Yerel Çalışma Süresi & Performans Monitörü" />
    <title>@(ViewData["Title"] ?? "Karavul") – Karavul</title>
    <link rel="icon" type="image/png" href="~/img/icon.png" />

    <link rel="stylesheet" href="~/css/karavul.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="main-wrapper">
        <header class="topbar">
            <a href="/" class="topbar-brand">
                <div class="brand-icon">
                    <img src="~/img/icon.png" alt="Karavul Logo" style="width: 24px; height: 24px; object-fit: contain;" />
                </div>
                <span class="brand-name">Karavul</span>
            </a>

            <nav class="topbar-nav">
                <a href="/" class="nav-item @(currentPath == "/" ? "active" : "")">
                    @Loc["genel-bakis"]
                </a>
                <a href="/Monitors" class="nav-item @(currentPath.StartsWith("/Monitors") ? "active" : "")">
                    @Loc["monitorler"]
                </a>
                <a href="/Incidents" class="nav-item @(currentPath.StartsWith("/Incidents") ? "active" : "")">
                    @Loc["olaylar"]
                </a>
                @if (Context.HasRole(Karavul.Core.Enums.UserRole.Admin | Karavul.Core.Enums.UserRole.Editor))
                {
                    <a href="/ContactGroups" class="nav-item @(currentPath.StartsWith("/ContactGroups") ? "active" : "")">
                        @Loc["iletisim-gruplari"]
                    </a>
                }
                <a href="/NotificationLogs" class="nav-item @(currentPath.StartsWith("/NotificationLogs") ? "active" : "")">
                    @Loc["bildirim-gecmisi"]
                </a>
                @if (Context.HasRole(Karavul.Core.Enums.UserRole.Admin))
                {
                    <a href="/Users" class="nav-item @(currentPath.StartsWith("/Users") ? "active" : "")">
                        Kullanıcılar
                    </a>
                    <a href="/Settings" class="nav-item @(currentPath.StartsWith("/Settings") ? "active" : "")">
                        @Loc["ayarlar"]
                    </a>
                }
            </nav>

            <div class="topbar-actions">
                <a href="/SetLanguage?lang=@(Loc.CurrentLanguage == "tr" ? "en" : "tr")&returnUrl=@currentPath" class="theme-toggle" title="@Loc["dil-secimi"]" style="text-decoration: none; font-weight: bold; font-size: 14px; display:flex; align-items:center; justify-content:center;">
                    @(Loc.CurrentLanguage == "tr" ? "EN" : "TR")
                </a>
                <button class="theme-toggle" id="themeToggle" title="@Loc["tema-degistir"]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                </button>
                <div class="user-dropdown-container">
                    <button class="user-avatar" id="userMenuBtn" title="@Loc["hesap-menusu"]">@username[0].ToString().ToUpper()</button>
                    <div class="user-dropdown-menu" id="userDropdownMenu">
                        <div class="dropdown-header" style="display:flex; flex-direction:column; line-height:1.2;">
                            <span style="font-weight:600;">@username</span>
                            <span style="font-size:0.75rem; color:var(--text-muted); font-weight:normal; margin-top:4px;">@userRoleStr</span>
                        </div>
                        <a href="/ChangePassword" class="dropdown-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                            @Loc["sifre-degistir"]
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="/Logout" class="dropdown-item text-danger">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            @Loc["cikis-yap"]
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    @TempData["Error"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <!-- Chart.js for Hangfire-style real-time graphs -->
    <script src="~/js/chart.min.js"></script>
    <script src="~/js/karavul.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
