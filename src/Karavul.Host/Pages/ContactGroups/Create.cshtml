@page
@model Karavul.Host.Pages.ContactGroups.CreateModel
@inject Karavul.Host.Localization.ILocalizationService Loc
@{
    ViewData["Title"] = Loc["yeni-iletisim-grubu"];
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Loc["yeni-iletisim-grubu"]</h1>
        <p class="page-subtitle">@Loc["iletisim-grubu-aciklama"]</p>
    </div>
    <a href="/ContactGroups" class="btn btn-secondary">← Geri</a>
</div>

<div class="card" style="max-width:800px;">
    <form method="post" id="groupForm">
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">@Loc["grup-adi"] *</label>
                <input name="Name" class="form-control" required value="@Model.Name" />
            </div>
            <div class="form-group">
                <label class="form-label">@Loc["tekrar-alarm-araligi"]</label>
                <input name="RepeatAlertMinutes" class="form-control" type="number" min="0" value="@Model.RepeatAlertMinutes" />
                <small style="color:var(--text-muted); font-size:0.74rem;">@Loc["tekrar-alarm-araligi-ipucu"]</small>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:24px;">
            <label class="form-label">@Loc["bildirim-kanallari"]</label>
            <div style="display:flex; gap:20px; align-items:center;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <label class="toggle-switch">
                        <input name="SelectedNotificationTypes" type="checkbox" value="Email" @(Model.SelectedNotificationTypes.Contains(Karavul.Core.Enums.NotificationType.Email) ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="form-label" style="margin:0;">@Loc["e-posta"]</span>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <label class="toggle-switch">
                        <input name="SelectedNotificationTypes" type="checkbox" value="Sms" @(Model.SelectedNotificationTypes.Contains(Karavul.Core.Enums.NotificationType.Sms) ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="form-label" style="margin:0;">@Loc["sms"]</span>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <label class="toggle-switch">
                        <input name="SelectedNotificationTypes" type="checkbox" value="Telegram" @(Model.SelectedNotificationTypes.Contains(Karavul.Core.Enums.NotificationType.Telegram) ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="form-label" style="margin:0;">Telegram</span>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:24px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:8px;">
                <label class="form-label" style="margin:0;">@Loc["grup-uyeleri"]</label>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('addDirectoryModal').showModal()">@Loc["rehberden-sec"]</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="addManualMember()">@Loc["manuel-ekle"]</button>
                </div>
            </div>
            
            <div class="table-responsive" style="border:1px solid var(--border); border-radius:8px; overflow:hidden;">
                <table class="table" style="margin:0;">
                    <thead>
                        <tr>
                            <th>@Loc["isim-soyisim"]</th>
                            <th>@Loc["iletisim-bilgileri"]</th>
                            <th style="width:60px; text-align:right;">@Loc["islem"]</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody">
                        @if (Model.Members.Count == 0)
                        {
                            <tr id="emptyMembersRow">
                                <td colspan="3" style="text-align:center; color:var(--text-muted); padding:24px;">
                                    @Loc["henuz-uye-eklenmedi"]
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="hiddenMembersContainer"></div>
        </div>

        <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
            <label class="toggle-switch">
                <input name="IsActive" type="checkbox" value="true" checked />
                <span class="toggle-slider"></span>
            </label>
            <span class="form-label" style="margin:0;">@Loc["aktif"]</span>
        </div>

        <div class="form-actions" style="margin-top:24px;">
            <button type="submit" class="btn btn-primary">@Loc["kaydet"]</button>
            <a href="/ContactGroups" class="btn btn-secondary">@Loc["iptal"]</a>
        </div>
    </form>
</div>

<!-- Add Directory Member Modal -->
<dialog id="addDirectoryModal" style="border:none; border-radius:12px; padding:0; box-shadow:0 20px 40px rgba(0,0,0,0.3); max-width:500px; width:100%; margin:auto; background:var(--bg-surface); color:var(--text-primary); overflow:hidden;">
    <div style="background:var(--bg-panel); padding:20px 24px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border);">
        <h2 class="card-title" style="margin:0; font-size:1.2rem;">@Loc["rehberden-kisi-sec"]</h2>
        <button type="button" onclick="document.getElementById('addDirectoryModal').close()" style="background:none;border:none;cursor:pointer;font-size:1.5rem;line-height:1;color:var(--text-muted); transition:color 0.2s;" onmouseover="this.style.color='var(--text-main)'" onmouseout="this.style.color='var(--text-muted)'">&times;</button>
    </div>
    <div style="padding:24px;">
        <div class="form-group">
            <label class="form-label">@Loc["kisi"]</label>
            <select id="directorySelect" class="form-control">
                <option value="">@Loc["kisi-secin"]</option>
                @foreach (var contact in Model.DirectoryContacts)
                {
                    <option value="@contact.Id" data-first="@contact.FirstName" data-last="@contact.LastName" data-email="@contact.Email" data-phone="@contact.PhoneNumber" data-telegram="@contact.TelegramChatId">
                        @contact.FirstName @contact.LastName
                    </option>
                }
            </select>
        </div>
        <div style="margin-top:24px; display:flex; justify-content:flex-end; gap:8px;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('addDirectoryModal').close()">@Loc["iptal"]</button>
            <button type="button" class="btn btn-primary" onclick="addSelectedDirectoryMember()">@Loc["ekle"]</button>
        </div>
    </div>
</dialog>

<!-- Add Manual Member Modal -->
<dialog id="addManualModal" style="border:none; border-radius:12px; padding:0; box-shadow:0 20px 40px rgba(0,0,0,0.3); max-width:500px; width:100%; margin:auto; background:var(--bg-surface); color:var(--text-primary); overflow:hidden;">
    <div style="background:var(--bg-panel); padding:20px 24px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border);">
        <h2 class="card-title" style="margin:0; font-size:1.2rem;">@Loc["manuel-ekle"]</h2>
        <button type="button" onclick="document.getElementById('addManualModal').close()" style="background:none;border:none;cursor:pointer;font-size:1.5rem;line-height:1;color:var(--text-muted); transition:color 0.2s;" onmouseover="this.style.color='var(--text-main)'" onmouseout="this.style.color='var(--text-muted)'">&times;</button>
    </div>
    <div style="padding:24px;">
        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group">
                <label class="form-label">@Loc["isim"] <span style="color:var(--text-muted); font-size:0.8em; font-weight:normal;">@Loc["zorunlu"]</span></label>
                <input type="text" id="manualFirstName" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">@Loc["soyisim"]</label>
                <input type="text" id="manualLastName" class="form-control" />
            </div>
        </div>
        <div class="form-group" style="margin-top:16px;">
            <label class="form-label">@Loc["e-posta"]</label>
            <input type="email" id="manualEmail" class="form-control" />
        </div>
        <div class="form-group" style="margin-top:16px;">
            <label class="form-label">@Loc["telefon"]</label>
            <input type="tel" id="manualPhone" class="form-control" />
        </div>
        <div class="form-group" style="margin-top:16px;">
            <label class="form-label">@Loc["telegram-chat-id"]</label>
            <input type="text" id="manualTelegram" class="form-control" />
        </div>
        
        <div style="margin-top:24px; display:flex; justify-content:flex-end; gap:8px;">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('addManualModal').close()">@Loc["iptal"]</button>
            <button type="button" class="btn btn-primary" onclick="submitManualMember()">@Loc["ekle"]</button>
        </div>
    </div>
</dialog>

@section Scripts {
    <script>
        let memberIndex = @Model.Members.Count;
        let members = []; // To track added members to avoid UI duplicates easily

        const locEmpty = "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Loc["henuz-uye-eklenmedi"]))";
        const locManual = "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Loc["manuel-giris"]))";
        const locDirectory = "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Loc["rehberden"]))";
        const locNoContact = "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Loc["iletisim-bilgisi-yok"]))";
        const locAtLeastOneContact = "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Loc["en-az-bir-iletisim-bilgisi"]))";

        function updateEmptyState() {
            const tbody = document.getElementById('membersTableBody');
            const emptyRow = document.getElementById('emptyMembersRow');
            if (tbody.children.length === 0 || (tbody.children.length === 1 && emptyRow)) {
                if (!emptyRow) {
                    tbody.innerHTML = `<tr id="emptyMembersRow"><td colspan="3" style="text-align:center; color:var(--text-muted); padding:24px;">${locEmpty}</td></tr>`;
                }
            } else if (emptyRow && tbody.children.length > 1) {
                emptyRow.remove();
            }
        }

        function addMemberRow(member) {
            const tbody = document.getElementById('membersTableBody');
            const emptyRow = document.getElementById('emptyMembersRow');
            if (emptyRow) emptyRow.remove();

            const rowId = `member-row-${memberIndex}`;
            
            let contactInfo = [];
            if (member.email) contactInfo.push(`<span title="E-posta" style="background:var(--bg-body); padding:2px 6px; border-radius:4px; font-size:0.8rem; display:inline-flex; align-items:center; gap:4px;"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>${member.email}</span>`);
            if (member.phone) contactInfo.push(`<span title="Telefon" style="background:var(--bg-body); padding:2px 6px; border-radius:4px; font-size:0.8rem; display:inline-flex; align-items:center; gap:4px;"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>${member.phone}</span>`);
            if (member.telegram) contactInfo.push(`<span title="Telegram" style="background:var(--bg-body); padding:2px 6px; border-radius:4px; font-size:0.8rem; display:inline-flex; align-items:center; gap:4px;"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>${member.telegram}</span>`);

            const isManual = !member.directoryId;

            const tr = document.createElement('tr');
            tr.id = rowId;
            tr.innerHTML = `
                <td>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <strong>${member.firstName} ${member.lastName}</strong>
                        ${isManual ? '<span style="font-size:0.7rem; color:var(--text-muted);">(' + locManual + ')</span>' : '<span style="font-size:0.7rem; color:var(--text-muted);">(' + locDirectory + ')</span>'}
                    </div>
                </td>
                <td>
                    <div style="display:flex; flex-wrap:wrap; gap:4px;">
                        ${contactInfo.join('')}
                        ${contactInfo.length === 0 ? '<span style="color:var(--text-muted); font-size:0.8rem;">' + locNoContact + '</span>' : ''}
                    </div>
                </td>
                <td style="text-align:right;">
                    <button type="button" class="btn btn-danger btn-sm btn-icon" onclick="removeMember(${memberIndex})">&times;</button>
                </td>
            `;
            tbody.appendChild(tr);

            const container = document.getElementById('hiddenMembersContainer');
            const html = `
                <div id="hidden-member-${memberIndex}">
                    <input type="hidden" name="Members[${memberIndex}].DirectoryContactId" value="${member.directoryId || ''}" />
                    <input type="hidden" name="Members[${memberIndex}].FirstName" value="${member.firstName || ''}" />
                    <input type="hidden" name="Members[${memberIndex}].LastName" value="${member.lastName || ''}" />
                    <input type="hidden" name="Members[${memberIndex}].Email" value="${member.email || ''}" />
                    <input type="hidden" name="Members[${memberIndex}].PhoneNumber" value="${member.phone || ''}" />
                    <input type="hidden" name="Members[${memberIndex}].TelegramChatId" value="${member.telegram || ''}" />
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);

            memberIndex++;
            updateEmptyState();
        }

        function removeMember(index) {
            const row = document.getElementById(`member-row-${index}`);
            if (row) row.remove();
            const hidden = document.getElementById(`hidden-member-${index}`);
            if (hidden) hidden.remove();
            updateEmptyState();
        }

        function addSelectedDirectoryMember() {
            const select = document.getElementById('directorySelect');
            const option = select.options[select.selectedIndex];
            if (!option.value) return;

            addMemberRow({
                directoryId: option.value,
                firstName: option.getAttribute('data-first'),
                lastName: option.getAttribute('data-last'),
                email: option.getAttribute('data-email'),
                phone: option.getAttribute('data-phone'),
                telegram: option.getAttribute('data-telegram')
            });

            document.getElementById('addDirectoryModal').close();
            select.value = '';
        }

        function addManualMember() {
            document.getElementById('manualFirstName').value = '';
            document.getElementById('manualLastName').value = '';
            document.getElementById('manualEmail').value = '';
            document.getElementById('manualPhone').value = '';
            document.getElementById('manualTelegram').value = '';
            document.getElementById('addManualModal').showModal();
        }
        
        function submitManualMember() {
            const firstName = document.getElementById('manualFirstName').value.trim();
            const lastName = document.getElementById('manualLastName').value.trim();
            const email = document.getElementById('manualEmail').value.trim();
            const phone = document.getElementById('manualPhone').value.trim();
            const telegram = document.getElementById('manualTelegram').value.trim();

            if (!firstName) {
                document.getElementById('manualFirstName').focus();
                return;
            }

            if (!email && !phone && !telegram) {
                alert(locAtLeastOneContact);
                return;
            }

            addMemberRow({
                directoryId: '',
                firstName: firstName,
                lastName: lastName || '',
                email: email || '',
                phone: phone || '',
                telegram: telegram || ''
            });
            
            document.getElementById('addManualModal').close();
        }
    </script>
}
